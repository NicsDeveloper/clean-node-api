{
  "name": "clean-node-api",
  "version": "1.4.0",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "start": "node dist/main/server.js",
    "debug": "nodemon -L --watch ./dist --inspect=0.0.0.0:9222 --nolazy ./dist/main/server.js",
    "build": "rimraf dist && tsc",
    "up": "npm run build && docker-compose up",
    "down": "docker-compose down",
    "test": "jest --passWithNoTests --silent --noStackTrace --runInBand",
    "test:verbose": "jest --passWithNoTests --runInBand",
    "test:unit": "npm test -- --watch -c jest-unit-config.js",
    "test:integration": "npm test -- --watch -c jest-integration-config.js",
    "test:ci": "npm test -- --coverage",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "test:staged": "npm test --findRelatedTests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NicsDeveloper/clean-node-api.git"
  },
  "author": "Nícolas Serrano",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/NicsDeveloper/clean-node-api/issues"
  },
  "homepage": "https://github.com/NicsDeveloper/clean-node-api#readme",
  "devDependencies": {
    "@shelf/jest-mongodb": "^4.3.2",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/mongodb": "^4.0.6",
    "@types/node": "^20.1.0",
    "@types/supertest": "^6.0.2",
    "@types/validator": "^13.12.1",
    "@typescript-eslint/eslint-plugin": "^6.4.0",
    "eslint": "^8.0.1",
    "eslint-config-standard-with-typescript": "^43.0.1",
    "eslint-plugin-import": "^2.25.2",
    "eslint-plugin-n": "^15.0.0",
    "eslint-plugin-promise": "^6.0.0",
    "git-commit-msg-linter": "^5.0.8",
    "husky": "^9.0.10",
    "jest": "^29.7.0",
    "lint-staged": "^13.2.2",
    "mockdate": "^3.0.5",
    "rimraf": "^6.0.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.2",
    "typescript": "*"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.8.0",
    "nodemon": "^3.1.4",
    "validator": "^13.12.0"
  }
}